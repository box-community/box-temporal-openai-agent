# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_COMPLEX_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.6-terra

# Box demo authentication (developer tokens are short-lived)
BOX_DEVELOPER_TOKEN=
BOX_FOLDER_ID=
# Choose exactly one internal-context source for the final Box AI review:
# comma-separated IDs for 1-24 explicitly selected files, or one existing Hub ID.
BOX_INTERNAL_FILE_IDS=
BOX_INTERNAL_HUB_ID=

# Local Temporal defaults
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=global-signal-desk
